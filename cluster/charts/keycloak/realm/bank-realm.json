{
  "realm": "bank",
  "displayName": "Bank",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "defaultSignatureAlgorithm": "PS256",
  "browserSecurityHeaders": {
    "strictTransportSecurity": ""
  },
  "attributes": {
    "CreateDefaultClientScopes": "true"
  },
  "components": {
    "org.keycloak.keys.KeyProvider": [
      {
        "name": "rsa-generated",
        "providerId": "rsa-generated",
        "subComponents": {},
        "config": {
          "priority": [
            "100"
          ],
          "keyUse": [
            "SIG"
          ],
          "algorithm": [
            "PS256"
          ]
        }
      },
      {
        "name": "rsa-enc-generated",
        "providerId": "rsa-enc-generated",
        "subComponents": {},
        "config": {
          "priority": [
            "100"
          ],
          "keyUse": [
            "ENC"
          ],
          "algorithm": [
            "RSA-OAEP"
          ]
        }
      },
      {
        "name": "hmac-generated-hs512",
        "providerId": "hmac-generated",
        "subComponents": {},
        "config": {
          "priority": [
            "100"
          ],
          "algorithm": [
            "HS512"
          ]
        }
      },
      {
        "name": "aes-generated",
        "providerId": "aes-generated",
        "subComponents": {},
        "config": {
          "priority": [
            "100"
          ]
        }
      }
    ],
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "name": "declarative-user-profile",
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"Username\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"Email\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"First name\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"Last name\",\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"multivalued\":false},{\"name\":\"customer_id\",\"displayName\":\"Customer number\",\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"validations\":{\"pattern\":{\"pattern\":\"^[A-Z0-9-]{1,36}$\",\"error-message\":\"A customer number is 1 to 36 capital letters, digits and hyphens\"}},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}]}"
          ]
        }
      }
    ]
  },
  "clientScopes": [
    {
      "name": "accounts",
      "description": "Account information: consents, account lists, details and balances",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read the accounts you choose"
      },
      "protocolMappers": [
        {
          "name": "audience bank-open-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "bank-open-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "payments",
      "description": "Payment initiation: payments the customer approves at the bank",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Start payments you approve at the bank"
      },
      "protocolMappers": [
        {
          "name": "audience bank-open-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "bank-open-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clientPolicies": {
    "policies": [
      {
        "name": "fapi-2-for-providers",
        "description": "Providers, the clients with scope accounts or payments, follow the FAPI 2.0 Security Profile",
        "enabled": true,
        "conditions": [
          {
            "condition": "client-scopes",
            "configuration": {
              "type": "Default",
              "scopes": [
                "accounts",
                "payments"
              ]
            }
          }
        ],
        "profiles": [
          "fapi-2-security-profile"
        ]
      }
    ]
  },
  "clients": [
    {
      "clientId": "smoke-test",
      "name": "Smoke test provider",
      "description": "The test provider scripts/smoke-test.sh signs in as",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "accounts",
        "payments"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "token.endpoint.auth.signing.alg": "PS256",
        "jwt.credential.certificate": "${SMOKE_TEST_CERTIFICATE}",
        "tls.client.certificate.bound.access.tokens": "true",
        "access.token.header.type.rfc9068": "true",
        "access.token.signed.response.alg": "PS256"
      }
    },
    {
      "clientId": "provider-app",
      "name": "Provider app",
      "description": "The provider's site in provider-app/: it signs in with its own key and certificate",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-jwt",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "consentRequired": true,
      "fullScopeAllowed": false,
      "defaultClientScopes": [
        "basic",
        "accounts",
        "payments"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "token.endpoint.auth.signing.alg": "PS256",
        "jwt.credential.certificate": "${PROVIDER_APP_CERTIFICATE}",
        "tls.client.certificate.bound.access.tokens": "true",
        "access.token.header.type.rfc9068": "true",
        "access.token.signed.response.alg": "PS256"
      }
    },
    {
      "clientId": "bank-approval",
      "name": "Bank approval pages",
      "description": "bank-open-api's pages where customers decide on consents and payments",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${APPROVAL_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "consentRequired": false,
      "fullScopeAllowed": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "https://localhost:8443/login/oauth2/code/keycloak"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "id.token.signed.response.alg": "PS256"
      },
      "defaultClientScopes": [
        "basic",
        "profile"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "customer number",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "customer_id",
            "claim.name": "customer_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "artem.demo",
      "enabled": true,
      "email": "artem.demo@example.com",
      "emailVerified": true,
      "firstName": "Artem",
      "lastName": "Demo",
      "attributes": {
        "customer_id": [
          "C1001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_CUSTOMER_PASSWORD}",
          "temporary": false
        }
      ]
    }
  ]
}
