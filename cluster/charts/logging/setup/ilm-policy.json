{
  "policy": {
    "_meta": {
      "description": "The bank's logs: an index a day, deleted 7 days after its rollover (scripts/cluster-up.sh)"
    },
    "phases": {
      "hot": {
        "actions": {
          "rollover": {
            "max_age": "1d",
            "max_primary_shard_size": "5gb"
          }
        }
      },
      "delete": {
        "min_age": "7d",
        "actions": {
          "delete": {}
        }
      }
    }
  }
}
